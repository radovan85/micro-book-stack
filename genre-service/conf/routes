# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

#Genres
GET   /api/genres    com.radovan.play.controllers.BookGenreController.getAllGenres
GET   /api/genres/:id    com.radovan.play.controllers.BookGenreController.getGenreDetails(id:Integer)
POST   /api/genres    com.radovan.play.controllers.BookGenreController.createGenre(request:Request)
PUT   /api/genres/:id    com.radovan.play.controllers.BookGenreController.updateGenre(request:Request,id:Integer)
DELETE   /api/genres/:id    com.radovan.play.controllers.BookGenreController.deleteGenre(request:Request,id:Integer)

#Health
GET     /api/health     com.radovan.play.controllers.HealthController.healthCheck(request:Request)